#!/bin/bash
set -eu

ACTION=${1:-}
IP_BIN=${ZEROLAB_IP_BIN:-/usr/sbin/ip}
SYSCTL_BIN=${ZEROLAB_SYSCTL_BIN:-/usr/sbin/sysctl}
STATE_DIR=${ZEROLAB_NETWORK_STATE_DIR:-/run/zerolab-network}
ETH=${ZEROLAB_ETH:-enp86s0}
WIFI=${ZEROLAB_WIFI:-wlo1}
ADDRESS=192.168.88.213/32
ARP_KEY="net.ipv4.conf.$WIFI.arp_ignore"

case "$STATE_DIR" in
  /run/* | /tmp/*) ;;
  *)
    echo "invalid ZeroLab network state directory: $STATE_DIR" >&2
    exit 2
    ;;
esac

stop_network()
{
  STOP_RC=0

  if [ -f "$STATE_DIR/arp_ignore.old" ]; then
    IFS= read -r OLD_ARP_IGNORE < "$STATE_DIR/arp_ignore.old" ||
      OLD_ARP_IGNORE=0
    "$SYSCTL_BIN" -w "$ARP_KEY=$OLD_ARP_IGNORE" || STOP_RC=1
  fi

  if [ -f "$STATE_DIR/address.added" ]; then
    "$IP_BIN" address delete "$ADDRESS" dev "$ETH" || STOP_RC=1
  fi

  rm -f \
    "$STATE_DIR/active" \
    "$STATE_DIR/address.added" \
    "$STATE_DIR/arp_ignore.old"
  rmdir "$STATE_DIR" 2>/dev/null || true
  return "$STOP_RC"
}

case "$ACTION" in
  start)
    if [ -f "$STATE_DIR/active" ]; then
      exit 0
    fi
    if [ -d "$STATE_DIR" ]; then
      stop_network
    fi

    umask 077
    mkdir -p "$STATE_DIR"
    "$SYSCTL_BIN" -n "$ARP_KEY" > "$STATE_DIR/arp_ignore.old"

    START_COMMITTED=0
    rollback_on_exit()
    {
      START_RC=$?
      trap - EXIT
      if [ "$START_COMMITTED" -ne 1 ]; then
        stop_network || true
      fi
      exit "$START_RC"
    }
    trap rollback_on_exit EXIT
    trap 'exit 1' HUP INT TERM

    if ! "$IP_BIN" -4 address show dev "$ETH" |
      grep -Fq "inet $ADDRESS "
    then
      : > "$STATE_DIR/address.added"
      "$IP_BIN" address add "$ADDRESS" dev "$ETH"
    fi

    "$SYSCTL_BIN" -w "$ARP_KEY=1"
    : > "$STATE_DIR/active"
    START_COMMITTED=1
    ;;
  stop)
    stop_network
    ;;
  *)
    echo "usage: $0 {start|stop}" >&2
    exit 2
    ;;
esac
